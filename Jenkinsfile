pipeline {
    agent any

    stages {

        stage('Welcome') {
            steps {
                echo 'Welcome to Jenkins Pipeline'
            }
        }

        stage('Build') {
            steps {
                echo 'Application Build Started'
            }
        }

        stage('Testing') {
            steps {
                echo 'Running Tests'
            }
        }

        stage('Deployment') {
            steps {
                echo 'Deploying Application'
            }
        }
    }
}
